rules_version = '2';

// TomaSafe Firestore rules. Paste into Firebase console > Firestore Database > Rules > Publish.
// Phones sign in anonymously and may only write their own documents; the PC server
// (firebase-admin) is not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeAlert() {
      return get(/databases/$(database)/documents/meta/activeIncident).data;
    }

    // The sign-in fields shared by devices and profiles. phone, recipientType and
    // androidId are optional so older app versions can still register.
    function validSignIn(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && (!('idNumber' in data) || data.idNumber == null || (data.idNumber is string && data.idNumber.size() <= 40))
        && (!('phone' in data) || (data.phone is string && data.phone.matches('^09[0-9]{9}$')))
        && (!('recipientType' in data) || data.recipientType in ['student', 'faculty', 'campus_personnel'])
        && (!('androidId' in data) || (data.androidId is string && data.androidId.matches('^[A-Za-z0-9-]{8,64}$')));
    }

    // Each phone's push token and its owner's sign-in.
    match /devices/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'name', 'idNumber', 'phone', 'recipientType', 'androidId', 'platform', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() < 4096
        && validSignIn(request.resource.data);
    }

    // The sign-in, keyed by the phone's Android ID, which survives an app reinstall,
    // so a reinstalled app can restore it. Readable only by id (no listing): the
    // Android ID is a random 64-bit value per phone and app signing key. Only the
    // PC server deletes these (when an admin deletes the recipient).
    match /profiles/{androidId} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'idNumber', 'phone', 'recipientType', 'uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phone is string
        && request.resource.data.recipientType is string
        && validSignIn(request.resource.data);
    }

    // Which alert is active (written by the PC server).
    match /meta/activeIncident {
      allow read: if signedIn();
    }

    // A phone's status for the active alert only; statuses never go backwards.
    match /incidents/{incidentId}/status/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && activeAlert().active == true && activeAlert().id == incidentId
        && request.resource.data.status in ['navigating', 'arrived', 'safe_confirmed']
        && request.resource.data.rank is int
        && (resource == null || request.resource.data.rank >= resource.data.rank);
    }
  }
}
